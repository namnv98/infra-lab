# Luật phát hiện (SIEM nhẹ): mỗi luật là một truy vấn LogQL trên Loki, chạy mỗi phút.
# Cảnh báo hiện ở Grafana → Alerting → Alert rules (chưa gửi email/chat).
apiVersion: 1
groups:
  - orgId: 1
    name: lab-security
    folder: SIEM
    interval: 1m
    rules:
{% set rules = [
  {"uid": "dmz-probe", "sev": "critical",
   "title": "Máy trong DMZ cố vào mạng nội bộ",
   "expr": 'sum(count_over_time({app="filterlog", action="block"} | src=~"10\\\\.10\\\\.10\\\\..+" | dst=~"10\\\\.(20|30|40)\\\\..+" [5m]))',
   "threshold": 0,
   "summary": "Firewall chặn DMZ đi vào LAN/MGMT/storage. DMZ không bao giờ có lý do làm vậy: dấu hiệu edge-01 bị chiếm."},
  {"uid": "lan-block-burst", "sev": "warning",
   "title": "Một máy nội bộ bị chặn liên tục",
   "expr": 'sum by (src) (count_over_time({app="filterlog", action="block"} | src=~"10\\\\.(20|40)\\\\..+" [5m]))',
   "threshold": 50,
   "summary": "Hơn 50 kết nối bị chặn trong 5 phút từ cùng một máy (LAN hoặc MGMT): dò mạng, malware gọi ra ngoài, phần mềm gửi telemetry, hoặc cấu hình sai."},
  {"uid": "squid-denied", "sev": "warning",
   "title": "Squid từ chối tên miền ngoài danh sách",
   "expr": 'sum(count_over_time({app="squid"} |= "TCP_DENIED" [5m]))',
   "threshold": 0,
   "summary": "Có máy cố tải từ tên miền không được phép."},
  {"uid": "k8s-exec", "sev": "warning",
   "title": "Có người kubectl exec vào Pod",
   "expr": 'sum by (user, namespace, pod) (count_over_time({app="k8s-audit"} | subresource="exec" |= "ResponseStarted" | regexp `"namespace":"[^"]*","name":"(?P<pod>[^"]*)"` [5m]))',
   "threshold": 0,
   "summary": "Hành động đặc quyền: {{ $labels.user }} mở shell trong Pod {{ $labels.namespace }}/{{ $labels.pod }}. Mỗi cặp người–Pod là một cảnh báo riêng, để lần exec sau không bị chìm trong cảnh báo đang bật."},
  {"uid": "k8s-psa-denied", "sev": "warning",
   "title": "Pod bị Pod Security từ chối",
   "expr": 'sum(count_over_time({app="k8s-audit"} |= "violates PodSecurity" [5m]))',
   "threshold": 0,
   "summary": "Có ai đó thử chạy container không đạt chuẩn (privileged, root...)."},
  {"uid": "ssh-fail", "sev": "warning",
   "title": "Đăng nhập SSH thất bại liên tục",
   "expr": 'sum by (host) (count_over_time({app="sshd"} |~ "Failed password|Invalid user|authentication failure" [5m]))',
   "threshold": 3,
   "summary": "Có thể đang bị dò mật khẩu."},
  {"uid": "svc-exec", "sev": "critical",
   "title": "User dịch vụ mạng chạy chương trình",
   "expr": 'sum by (host) (count_over_time({audit_key="svc_exec"} [5m]))',
   "threshold": 0,
   "summary": "haproxy/squid chạy một chương trình: bình thường không bao giờ xảy ra, dấu hiệu dịch vụ bị khai thác."},
  {"uid": "identity-change", "sev": "warning",
   "title": "Thay đổi user, sudoers hoặc SSH key",
   "expr": 'sum by (host) (count_over_time({audit_key=~"identity|privilege|ssh_keys|sshd_config"} [5m]))',
   "threshold": 0,
   "summary": "Có thay đổi tài khoản, quyền sudo hoặc khoá SSH: kiểm tra có phải thay đổi đã được duyệt."},
  {"uid": "persistence", "sev": "warning",
   "title": "Tạo/sửa systemd unit hoặc cron",
   "expr": 'sum by (host) (count_over_time({audit_key="persistence"} [5m]))',
   "threshold": 0,
   "summary": "Cách kẻ tấn công thường dùng để bám trụ lại máy sau khi khởi động lại."},
  {"uid": "wazuh-high", "sev": "critical",
   "title": "Wazuh: cảnh báo mức cao (≥ 10)",
   "expr": 'sum by (host) (count_over_time({app="wazuh", wazuh_level=~"1[0-5]"} [5m]))',
   "threshold": 0,
   "summary": "Bộ luật của Wazuh phát hiện sự kiện nghiêm trọng (rootkit, file hệ thống bị sửa, dò mật khẩu...). Xem chi tiết rule_desc trong Explore."},
] %}
{% for r in rules %}
      - uid: {{ r.uid }}
        title: "{{ r.title }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: loki
            model:
              refId: A
              expr: '{{ r.expr }}'
              queryType: instant
          - refId: B
            datasourceUid: __expr__
            model: { refId: B, type: reduce, expression: A, reducer: last }
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions: [{ evaluator: { type: gt, params: [{{ r.threshold }}] } }]
        noDataState: OK
        execErrState: Error
        for: 0s
        labels: { severity: {{ r.sev }} }
        annotations: { summary: "{{ r.summary }}" }
{% endfor %}

      # ---------- Luật GHÉP NHIỀU NGUỒN ----------
      # Bắn khi CÙNG LÚC: (1) auditd thấy user haproxy trên edge-01 chạy chương trình, VÀ
      # (2) firewall chặn edge-01 đi vào mạng nội bộ. Hai sự kiện riêng lẻ có thể là nhiễu; cùng nhau = edge-01 bị chiếm.
      - uid: dmz-compromised
        title: "edge-01 bị chiếm: chạy lệnh lạ + dò mạng nội bộ"
        condition: D
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: loki
            model: { refId: A, queryType: instant, expr: 'sum(count_over_time({host="edge-01", audit_key="svc_exec"} [10m]))' }
          - refId: B
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: loki
            model: { refId: B, queryType: instant, expr: 'sum(count_over_time({app="filterlog", action="block"} | src="{{ plan.hosts[groups['edge'][0]].ip }}" [10m]))' }
          - refId: RA
            datasourceUid: __expr__
            model: { refId: RA, type: reduce, expression: A, reducer: last, settings: { mode: replaceNN, replaceWithValue: 0 } }
          - refId: RB
            datasourceUid: __expr__
            model: { refId: RB, type: reduce, expression: B, reducer: last, settings: { mode: replaceNN, replaceWithValue: 0 } }
          - refId: D
            datasourceUid: __expr__
            model: { refId: D, type: math, expression: "$RA > 0 && $RB > 0" }
        noDataState: OK
        execErrState: Error
        for: 0s
        labels: { severity: critical, correlation: "true" }
        annotations: { summary: "Trong 10 phút: user haproxy trên edge-01 chạy chương trình VÀ firewall chặn edge-01 đi vào mạng trong. Cô lập edge-01 ngay (chặn trên OPNsense), giữ nguyên máy để điều tra." }
