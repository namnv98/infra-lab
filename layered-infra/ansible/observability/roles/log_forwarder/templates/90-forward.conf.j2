# Do Ansible quản lý (role log_forwarder, team observability): gửi mọi log về siem-01 (VLAN MGMT) qua TCP, chuẩn RFC5424.
# Hàng đợi trên đĩa: siem-01 tạm ngừng thì log được giữ lại (tối đa 200MB) và gửi bù khi có lại kết nối.
{% if log_files | default([]) | length > 0 %}
module(load="imfile")
{% endif %}
{% for f in log_files | default([]) %}
input(type="imfile" File="{{ f.path }}" Tag="{{ f.tag }}" Facility="local6" Severity="info" reopenOnTruncate="on")
{% endfor %}

*.* action(
  type="omfwd" target="{{ mon_ip }}" port="{{ mon_syslog_port }}" protocol="tcp"
  Template="RSYSLOG_SyslogProtocol23Format"
  queue.type="LinkedList" queue.filename="fwd_mon1" queue.maxDiskSpace="200m"
  queue.saveOnShutdown="on" action.resumeRetryCount="-1"
)
