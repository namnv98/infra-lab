{% for name, range in metallb_pools.items() %}
---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ name }}
  namespace: metallb-system
spec:
  addresses: ["{{ range }}"]
  autoAssign: {{ 'false' if name == 'public' else 'true' }}   # pool public chỉ cấp khi được yêu cầu rõ
{% endfor %}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: l2
  namespace: metallb-system
spec:
  ipAddressPools: {{ metallb_pools.keys() | list | to_json }}
  interfaces: ["{{ node_interface }}"]
