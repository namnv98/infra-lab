# Do Ansible quản lý (role network/edge_lb_waf). WAF = nginx + ModSecurity v3 + OWASP CRS v4 (image chính thức của CRS).
# Mạng host: nghe :{{ waf_port }}, gọi về HAProxy 127.0.0.1:{{ waf_upstream_port }}. Cổng {{ waf_port }} không mở ra ngoài:
# OPNsense chỉ cho vào DMZ 80/443, và không vùng nào khác được tới edge-01:{{ waf_port }}.
# Log (kể cả audit JSON của ModSecurity) → journald → rsyslog → siem-01.
[Unit]
Description=WAF (ModSecurity + OWASP CRS) truoc Gateway public
After=docker.service
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f waf
ExecStart=/usr/bin/docker run --rm --name waf --network host \
  --user 101:101 --cap-drop ALL --security-opt no-new-privileges \
  --log-driver journald --log-opt tag=waf \
  -e PORT={{ waf_port }} \
  -e BACKEND=http://127.0.0.1:{{ waf_upstream_port }} \
  -e MODSEC_RULE_ENGINE=On \
  -e BLOCKING_PARANOIA={{ waf_paranoia }} \
  -e ANOMALY_INBOUND={{ waf_anomaly_inbound }} \
  -e ANOMALY_OUTBOUND=4 \
  -e MODSEC_AUDIT_ENGINE=RelevantOnly \
  -e MODSEC_AUDIT_LOG_FORMAT=JSON \
  -e MODSEC_AUDIT_LOG=/dev/stdout \
  -e REAL_IP_HEADER=X-Forwarded-For \
  -e SET_REAL_IP_FROM=127.0.0.1 \
  docker.io/{{ waf_image }}
ExecStop=/usr/bin/docker stop waf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
