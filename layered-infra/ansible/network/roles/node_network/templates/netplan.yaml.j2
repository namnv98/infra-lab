# Do Ansible quản lý (role node_network, team network). cloud-init không còn ghi đè file này.
{% if node_network_mode == 'static' %}
# On-prem: IP tĩnh từ hosts.yml, gateway = firewall của VLAN ({{ zones[node_zone].gateway }}), DNS = Unbound của OPNsense.
{% else %}
# GCP: IP và route vẫn lấy qua DHCP của VPC (route 0.0.0.0/0 của VPC đã trỏ vào OPNsense),
# chỉ thay DNS bằng Unbound của OPNsense {{ zone_fw }} (thay DNS của Google 169.254.169.254).
{% endif %}
network:
  version: 2
  ethernets:
    {{ node_interface }}:
{% if node_network_mode == 'static' %}
      dhcp4: false
      addresses: [{{ ansible_host }}/{{ zones[node_zone].cidr.split('/')[1] }}]
      routes: [{ to: default, via: {{ zones[node_zone].gateway }} }]
      mtu: {{ lab_mtu | default(1500) }}
{% else %}
      dhcp4: true
      dhcp4-overrides: { use-dns: false, use-domains: false }
{% endif %}
      nameservers: { addresses: [{{ zone_fw }}], search: [{{ lab_domain }}] }
