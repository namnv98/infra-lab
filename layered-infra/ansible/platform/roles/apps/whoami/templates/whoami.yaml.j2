apiVersion: v1
kind: Namespace
metadata:
  name: demo
  labels:
    gateway.lab/public: "true"
    gateway.lab/internal: "true"
    lab/policy: strict           # Kyverno ép chỉ dùng image từ Harbor (role security/kyverno)
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: whoami, namespace: demo }
spec:
  replicas: 2
  selector: { matchLabels: { app: whoami } }
  template:
    metadata: { labels: { app: whoami } }
    spec:
      topologySpreadConstraints:            # trải pod ra nhiều node khi có (mềm: 1 worker vẫn chạy được)
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: ScheduleAnyway
        labelSelector: { matchLabels: { app: whoami } }
      securityContext:                      # đã đạt chuẩn Pod Security "restricted"
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile: { type: RuntimeDefault }
      containers:
      - name: whoami
        image: {{ harbor_host }}/dockerhub/traefik/whoami:v1.11.0   # ghi rõ Harbor (policy restrict-image-registries)
        args: [--port=8080]
        ports: [{ containerPort: 8080 }]
        readinessProbe: { httpGet: { path: /health, port: 8080 }, periodSeconds: 10 }
        livenessProbe: { httpGet: { path: /health, port: 8080 }, periodSeconds: 20 }
        resources:
          requests: { cpu: 10m, memory: 16Mi }
          limits: { memory: 64Mi }
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities: { drop: [ALL] }
---
# Nâng cấp/drain node: luôn còn ít nhất 1 pod phục vụ
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata: { name: whoami, namespace: demo }
spec:
  maxUnavailable: 1
  selector: { matchLabels: { app: whoami } }
---
# Tự tăng/giảm số pod theo CPU (số liệu từ metrics-server)
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata: { name: whoami, namespace: demo }
spec:
  scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: whoami }
  minReplicas: 2
  maxReplicas: 4
  metrics:
  - type: Resource
    resource: { name: cpu, target: { type: Utilization, averageUtilization: 70 } }
---
apiVersion: v1
kind: Service
metadata: { name: whoami, namespace: demo }
spec:
  selector: { app: whoami }
  ports: [{ port: 80, targetPort: 8080 }]
{% for name, gw in gateways.items() %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata: { name: whoami-{{ name }}, namespace: demo }
spec:
  parentRefs: [{ name: {{ name }}, namespace: gateway, sectionName: https }]
  hostnames: [whoami.{{ gw.domain }}]
  rules:
  - backendRefs: [{ name: whoami, port: 80 }]   # WAF nằm ở vùng biên (edge-01), request public tới đây đã qua WAF
{% endfor %}
