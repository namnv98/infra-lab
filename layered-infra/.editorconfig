# Định dạng chung cho mọi editor/IDE (JetBrains, VS Code… tự đọc file này)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Không tự ngắt dòng Markdown (câu dài bị gãy giữa chừng); 2 dấu cách cuối dòng = xuống dòng
max_line_length = off
trim_trailing_whitespace = false
