# siem-01: thu log tập trung. Image lấy qua Harbor (MGMT không ra thẳng Internet).
services:
  loki:
    image: {{ mon_images.loki }}
    command: -config.file=/etc/loki/loki.yaml
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - ./data/loki:/loki
    restart: unless-stopped
    mem_limit: 512m

  alloy:
    image: {{ mon_images.alloy }}
    command: run --disable-reporting --server.http.listen-addr=0.0.0.0:12345 --storage.path=/var/lib/alloy /etc/alloy/config.alloy
    user: "0"                                         # đọc được alerts.json của Wazuh
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./data/alloy:/var/lib/alloy
      - wazuh_logs:/wazuh-logs:ro
      - ./data/flows:/flows:ro
    ports:
      - "{{ mon_syslog_port }}:{{ mon_syslog_port }}/tcp"     # syslog từ OPNsense, rsyslog các máy
    depends_on: [loki]
    restart: unless-stopped
    mem_limit: 384m

{% if sflow_enabled | bool %}
  # sFlow từ switch (IP quản trị của switch, VLAN MGMT): giải mã mỗi mẫu gói thành 1 dòng JSON → Alloy → Loki (app=sflow)
  goflow2:
    image: {{ mon_images_extra.goflow2 }}
    command: -listen=sflow://:{{ sflow_port }} -format=json -transport=file -transport.file=/flows/flows.json
    user: "0"                                         # ghi vào thư mục gắn từ máy (logrotate cắt file mỗi giờ)
    volumes:
      - ./data/flows:/flows
    ports:
      - "{{ sflow_port }}:{{ sflow_port }}/udp"
    restart: unless-stopped
    mem_limit: 64m

{% endif %}
  # Máy chủ SMTP của lab: nhận và giữ mọi email, xem ở http://{{ mon_ip }}:8025
  mailpit:
    image: {{ mon_images_extra.mailpit }}
    environment:
      MP_MAX_MESSAGES: "5000"
    volumes:
      - ./data/mailpit:/data
    command: --database /data/mailpit.db
    ports:
      - "8025:8025"
    restart: unless-stopped
    mem_limit: 96m

  grafana:
    image: {{ mon_images.grafana }}
    environment:
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      GF_NEWS_NEWS_FEED_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_PLUGINS_PREINSTALL_DISABLED: "true"      # không tự tải plugin từ grafana.com
      GF_ANALYTICS_FEEDBACK_LINKS_ENABLED: "false"
      GF_SMTP_ENABLED: "true"
      GF_SMTP_HOST: "{{ smtp_host }}"
      GF_SMTP_USER: "{{ smtp_user }}"
      GF_SMTP_PASSWORD: "{{ smtp_password }}"
      GF_SMTP_FROM_ADDRESS: "{{ smtp_from }}"
      GF_SMTP_FROM_NAME: "Grafana SIEM (lab)"
      GF_SMTP_STARTTLS_POLICY: "{{ 'NoStartTLS' if smtp_host.startswith('mailpit') else 'MandatoryStartTLS' }}"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./data/grafana:/var/lib/grafana
      - ./grafana-admin.txt:/run/secrets/grafana_admin:ro
    ports:
      - "3000:3000"
    depends_on: [loki, mailpit]
    restart: unless-stopped
    mem_limit: 384m

  # Wazuh manager: chỉ bộ phân tích + đăng ký agent; không chạy indexer/dashboard (tiết kiệm 3-4GB RAM)
  wazuh-manager:
    image: {{ wazuh_image }}
    hostname: wazuh-manager
    environment:
      INDEXER_URL: https://disabled.invalid:9200      # không có indexer: filebeat bên trong sẽ không gửi đi đâu
    ports:
      - "{{ wazuh_enroll_port }}:1515"                # đăng ký agent
      - "{{ wazuh_agent_port }}:1514"                 # agent gửi sự kiện
    volumes:
      - wazuh_etc:/var/ossec/etc
      - wazuh_logs:/var/ossec/logs
      - wazuh_queue:/var/ossec/queue
      - wazuh_var_multigroups:/var/ossec/var/multigroups
      - wazuh_integrations:/var/ossec/integrations
      - wazuh_active_response:/var/ossec/active-response/bin
      - wazuh_agentless:/var/ossec/agentless
      - wazuh_wodles:/var/ossec/wodles
    restart: unless-stopped
    mem_limit: 1g

volumes:
  wazuh_etc: {}
  wazuh_logs: {}
  wazuh_queue: {}
  wazuh_var_multigroups: {}
  wazuh_integrations: {}
  wazuh_active_response: {}
  wazuh_agentless: {}
  wazuh_wodles: {}
