# Static pod kube-vip: các master bầu leader qua Lease "plndr-cp-lock",
# leader giữ VIP {{ api_vip }} và trả lời ARP cho nó trên {{ node_interface }}.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
  - name: kube-vip
    image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
    imagePullPolicy: IfNotPresent
    args: [manager]
    env:
    - { name: address,            value: "{{ api_vip }}" }
    - { name: port,               value: "6443" }
    - { name: vip_interface,      value: "{{ node_interface }}" }
    - { name: vip_subnet,         value: "32" }
    - { name: vip_arp,            value: "true" }        # chế độ L2: quảng bá VIP bằng ARP
    - { name: cp_enable,          value: "true" }        # VIP cho control plane
    - { name: cp_namespace,       value: kube-system }
    - { name: svc_enable,         value: "false" }       # Service LoadBalancer để MetalLB lo
    - { name: vip_leaderelection, value: "true" }
    - { name: vip_leasename,      value: plndr-cp-lock }
    - { name: vip_leaseduration,  value: "15" }          # leader chết → sau tối đa ~15s master khác nhận VIP
    - { name: vip_renewdeadline,  value: "10" }
    - { name: vip_retryperiod,    value: "2" }
    - { name: prometheus_server,  value: ":2112" }
    - name: vip_nodename
      valueFrom: { fieldRef: { fieldPath: spec.nodeName } }
    securityContext:
      capabilities:
        add: [NET_ADMIN, NET_RAW]
        drop: [ALL]
    volumeMounts:
    - { name: kubeconfig, mountPath: /etc/kubernetes/admin.conf }
  hostAliases:
  - { ip: 127.0.0.1, hostnames: [kubernetes] }   # gọi apiserver cục bộ, không đi qua VIP
  hostNetwork: true
  volumes:
  - name: kubeconfig
    hostPath: { path: "/etc/kubernetes/{{ kube_vip_kubeconfig | default('admin.conf') }}" }
