{
  "uid": "lab-security",
  "title": "Lab · Bảo mật",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Firewall chặn / phút (theo interface)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (iface) (count_over_time({app=\"filterlog\"} |~ \",block,\" | regexp \"^[^,]*,[^,]*,[^,]*,[^,]*,(?P<iface>[^,]+),\" [1m]))", "legendFormat": "{{ '{{' }}iface{{ '}}' }}" } ] },
    { "id": 2, "type": "timeseries", "title": "Log nhận được / phút (theo máy)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (host) (count_over_time({job=\"syslog\"} [1m]))", "legendFormat": "{{ '{{' }}host{{ '}}' }}" } ] },
    { "id": 3, "type": "logs", "title": "Firewall: kết nối bị chặn",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{app=\"filterlog\"} |~ \",block,\"" } ] },
    { "id": 4, "type": "logs", "title": "Squid: tên miền bị từ chối",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{app=\"squid\"} |= \"TCP_DENIED\"" } ] },
    { "id": 5, "type": "logs", "title": "SSH / sudo",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{app=~\"sshd|sudo\"}" } ] },
    { "id": 6, "type": "logs", "title": "K8s audit: exec, tạo, sửa, xoá",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{app=\"k8s-audit\"} |~ \"\\\"verb\\\":\\\"(create|update|patch|delete)\\\"|subresource\\\":\\\"exec\" != \"system:serviceaccount\"" } ] }{% if sflow_enabled | bool %},
    { "id": 7, "type": "timeseries", "title": "Lưu lượng qua switch theo VLAN (sFlow, ước lượng = byte mẫu × tỉ lệ lấy mẫu)",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [ { "refId": "A", "expr": "sum by (vlan) (sum_over_time({app=\"sflow\"} | json | type=\"SFLOW_5\" | unwrap bytes [1m])) * on (vlan) group_left avg by (vlan) (avg_over_time({app=\"sflow\"} | json | type=\"SFLOW_5\" | unwrap sampling_rate [1m])) / 60", "legendFormat": "VLAN {{ '{{' }}vlan{{ '}}' }}" } ] },
    { "id": 8, "type": "table", "title": "Cặp máy nói chuyện nhiều nhất qua switch (sFlow, 15 phút)",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(10, sum by (src, dst, vlan) (sum_over_time({app=\"sflow\"} | json | unwrap bytes [15m])))" } ] }{% endif %}
  ]
}
